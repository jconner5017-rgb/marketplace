# Copy to .env for local runs outside Docker. Never commit .env.
APP_ENV=dev
ADDR=:8080
DATABASE_URL=postgres://marketplace:marketplace@localhost:5432/marketplace?sslmode=disable

# Optional
# COOKIE_SECURE=true        # defaults to true unless APP_ENV=dev
# SESSION_TTL_HOURS=720     # 30 days
# TRUST_PROXY_HEADERS=true  # behind a load balancer (Render sets this)
# PORT=10000                # used when ADDR is unset

# For integration tests (a throwaway database; tests wipe it)
# TEST_DATABASE_URL=postgres://marketplace:marketplace@localhost:5432/marketplace_test?sslmode=disable
